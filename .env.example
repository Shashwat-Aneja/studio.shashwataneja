# Server only. Configure directly in Vercel Preview for feature/studio-foundation.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Verified sender on your authenticated domain
STUDIO_FROM_EMAIL=
